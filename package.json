{
  "name": "vue-aliplay-player",
  "version": "4.0.0",
  "private": false,
  "license": "MIT",
  "author": "Jabo <jabo@users.noreply.github.com>",
  "type": "module",
  "packageManager": "pnpm@10.34.5",
  "description": "阿里云 Aliplayer 的 Vue 3 播放器组件封装（v4 for Vue 3，Vue 2 项目请使用 3.x）",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Jabo2017/vue-aliplay-player.git"
  },
  "homepage": "https://jabo2017.github.io/vue-aliplay-player/",
  "bugs": {
    "url": "https://github.com/Jabo2017/vue-aliplay-player/issues"
  },
  "keywords": [
    "vue",
    "vue3",
    "aliplayer",
    "player",
    "hls",
    "m3u8",
    "flv",
    "video-player"
  ],
  "main": "./dist/vue-aliplay-player.umd.cjs",
  "module": "./dist/vue-aliplay-player.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/vue-aliplay-player.js",
      "require": "./dist/vue-aliplay-player.umd.cjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "vite --config demo/vite.config.ts",
    "build": "vite build",
    "build:demo": "vite build --config demo/vite.config.ts",
    "preview": "vite preview --config demo/vite.config.ts",
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest run",
    "prepublishOnly": "npm run build"
  },
  "peerDependencies": {
    "vue": "^3.2.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@vitejs/plugin-vue": "^6.0.0",
    "@vue/test-utils": "^2.5.0",
    "jsdom": "^30.0.0",
    "typescript": "^5.9.0",
    "vite": "^7.0.0",
    "vite-plugin-dts": "^4.5.0",
    "vitest": "^5.0.0",
    "vue": "^3.5.0",
    "vue-tsc": "^3.3.0"
  }
}
